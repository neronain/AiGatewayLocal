[Unit]
Description=LiteGate
Documentation=https://github.com/neronain/AiGatewayLocal
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=litegate
Group=litegate
WorkingDirectory=/opt/litegate

# ค่าตั้งต้นของจำนวน worker — ต้องอยู่ **ก่อน** EnvironmentFile เสมอ เพราะ systemd ให้
# บรรทัดที่มาทีหลังชนะ · .env จึงทับค่านี้ได้ ส่วนเครื่องที่ติดตั้งไว้ก่อนหน้าและ .env
# ยังไม่มีบรรทัด GW_WORKERS จะได้ 1 ซึ่งเป็นค่าที่ถูกสำหรับการติดตั้งแบบไม่มี Redis
Environment=GW_WORKERS=1

# Secrets live here, readable only by the service user (chmod 600).
EnvironmentFile=/opt/litegate/.env

# --workers ต้องมาจาก GW_WORKERS ไม่ใช่ตัวเลขตายตัว
#
# เดิม unit นี้เขียน `--workers 4` ไว้ตรง ๆ · `GW_WORKERS` ถูกอ่านโดย `app.main:run`
# เท่านั้น ซึ่งเป็น console script ที่ unit นี้ไม่ได้เรียก (มันเรียก uvicorn ตรง ๆ) ·
# ผลคือ `scripts/bootstrap.sh` เขียน `GW_WORKERS=1` ลง .env แล้วเครื่องก็ยังรัน 4 worker
# อยู่ดี — ซึ่งคือบั๊กที่ 1.12.1 ประกาศว่าแก้แล้วแต่แก้ไม่ถึงตรงนี้
#
# ซ้ำร้ายกว่านั้น: `app/state.py` ตัดสินว่าจะเตือนหรือไม่จาก `settings.workers` (= 1)
# **คำเตือนจึงไม่ขึ้นบนเครื่องที่ต้องการมันที่สุด** — เครื่องที่รัน 4 worker โดยไม่มี Redis
# แล้ว max_concurrency: 1 ของทุก endpoint กลายเป็น 4 คำขอพร้อมกันจริงที่ backend
#
# พอ unit อ่านค่าเดียวกับที่แอปอ่าน ทั้งจำนวน worker จริงและคำเตือนก็ตรงกันเองทั้งคู่
ExecStart=/opt/litegate/.venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 8080 \
    --workers ${GW_WORKERS} \
    --proxy-headers \
    --forwarded-allow-ips '*'

ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
# Give in-flight streaming responses a chance to finish before SIGKILL.
TimeoutStopSec=30
KillSignal=SIGTERM

# --- Hardening -------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
# ProtectSystem=strict makes the whole filesystem read-only to this service, so
# every path the console writes to has to be listed here.
#
# config/ is on this list because the console *is* how models get added: the
# installer finishes by telling the operator to open Models → Detect, and that
# writes config/models/<alias>.yaml. Enabling and disabling a model rewrites the
# same file. Leave config/ out and a fresh install on a real machine shows
# "the registry is read-only" with the Save button greyed out, which reads as a
# broken product — nobody sees it during development because the dev boxes run
# in containers where systemd's sandboxing is disabled.
#
# The registry holds no secrets: `api_key_env` is the *name* of an environment
# variable, never its value. Sites that keep the registry in git and want it
# read-only should install with REGISTRY_READONLY=1, which drops config/ from
# this line.
ReadWritePaths=/opt/litegate/data /opt/litegate/logs /opt/litegate/config
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# --- Limits ----------------------------------------------------------------
LimitNOFILE=65535
MemoryMax=4G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=litegate

[Install]
WantedBy=multi-user.target
