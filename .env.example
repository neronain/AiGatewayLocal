# ---------------------------------------------------------------------------
# EduLLM Gateway - environment configuration
# Copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core ---
GW_ENV=development                 # development | staging | production
GW_HOST=0.0.0.0
GW_PORT=8080
GW_LOG_LEVEL=INFO
GW_WORKERS=4

# --- Security ---
# 32+ random bytes, used to HMAC API keys at rest. Rotate = all keys invalid.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
GW_API_KEY_PEPPER=change-me-to-a-long-random-string
# Comma-separated origins allowed to call the gateway from a browser.
GW_CORS_ORIGINS=http://localhost:3000
# Bootstrap admin key, created on first start if the DB has no admin.
GW_BOOTSTRAP_ADMIN_KEY=

# --- Database ---
# dev  : sqlite+aiosqlite:///./data/gateway.db
# prod : postgresql+asyncpg://edullm:password@postgres:5432/edullm
GW_DATABASE_URL=sqlite+aiosqlite:///./data/gateway.db

# --- Redis (optional; quota + rate limit counters shared across workers) ---
# Leave empty to fall back to the database-backed counter store.
GW_REDIS_URL=

# --- Model registry ---
GW_CONFIG_DIR=./config
GW_REGISTRY_RELOAD_SECONDS=30      # 0 disables hot reload

# --- Upstream ---
GW_UPSTREAM_CONNECT_TIMEOUT=10
GW_UPSTREAM_READ_TIMEOUT=600       # long generations / agent loops
GW_UPSTREAM_MAX_CONNECTIONS=200

# --- Backend API keys referenced by config/models/*.yaml via api_key_env ---
DGX01_API_KEY=
DGX02_API_KEY=
DGX03_API_KEY=
